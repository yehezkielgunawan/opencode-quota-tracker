{
  "name": "opencode-quota-tracker",
  "version": "0.1.2",
  "description": "Cross-provider subscription, API, and local usage accounting for the OpenCode TUI",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/yehezkielgunawan/opencode-quota-tracker.git"
  },
  "bugs": {
    "url": "https://github.com/yehezkielgunawan/opencode-quota-tracker/issues"
  },
  "homepage": "https://github.com/yehezkielgunawan/opencode-quota-tracker#readme",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "quota",
    "usage",
    "tui"
  ],
  "exports": {
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "oc-plugin": [
    "tui"
  ],
  "packageManager": "pnpm@9.4.0",
  "engines": {
    "node": ">=22.12.0",
    "opencode": ">=1.18.0"
  },
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "pnpm clean && tsc -p tsconfig.build.json && node scripts/build-tui.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "prepack": "pnpm build && node scripts/verify-package.mjs"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.18.5",
    "@opentui/core": "^0.4.5",
    "@opentui/keymap": "^0.4.5",
    "@opentui/solid": "^0.4.5",
    "solid-js": "^1.9.12"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@opencode-ai/plugin": "1.18.5",
    "@opentui/core": "0.4.5",
    "@opentui/keymap": "0.4.5",
    "@opentui/solid": "0.4.5",
    "@types/babel__core": "7.20.5",
    "@types/node": "22.18.0",
    "babel-preset-solid": "1.9.12",
    "solid-js": "1.9.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "overrides": {
      "@babel/core@<=7.29.0": "7.29.7",
      "brace-expansion@<=5.0.7": "5.0.8"
    }
  }
}
