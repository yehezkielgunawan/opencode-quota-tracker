{
  "name": "opencode-quota-tracker",
  "version": "0.0.0",
  "description": "Cross-provider subscription, API, and local usage accounting for the OpenCode TUI",
  "private": false,
  "type": "module",
  "exports": {
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "oc-plugin": [
    "tui"
  ],
  "packageManager": "pnpm@9.4.0",
  "engines": {
    "node": ">=22",
    "opencode": ">=1.18.0"
  },
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "pnpm clean && node scripts/build-tui.mjs && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.18.5",
    "@opentui/core": "^0.4.5",
    "@opentui/keymap": "^0.4.5",
    "@opentui/solid": "^0.4.5",
    "solid-js": "^1.9.12"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@opencode-ai/plugin": "1.18.5",
    "@opentui/core": "0.4.5",
    "@opentui/keymap": "0.4.5",
    "@opentui/solid": "0.4.5",
    "babel-preset-solid": "1.9.12",
    "solid-js": "1.9.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
